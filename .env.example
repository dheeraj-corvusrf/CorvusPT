# Supabase project credentials, used for real user sign-up/sign-in and profile storage.
# Get these from your Supabase project: Project Settings > API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — safe to ship in the client bundle,
# access is enforced server-side by the Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms access key, used by the contact form to actually deliver submissions to
# an inbox. Get one free at https://web3forms.com — it's meant to be public/client-side
# (that's the whole point of the service), protected by their own spam filtering and
# optional domain restriction, not by keeping it secret.
VITE_WEB3FORMS_ACCESS_KEY=

# Google Maps Platform API key (Places API (New) enabled), used by
# AddressAutocomplete for real Google address suggestions — falls back to free
# Nominatim/OpenStreetMap automatically if this is unset or the request fails
# (e.g. the key's website restrictions don't cover the current domain). Get one
# from Google Cloud Console > APIs & Services > Credentials, and restrict it to
# "Places API" + your real domain(s) under Website restrictions — it runs
# client-side, so it needs those restrictions instead of being kept secret.
VITE_GOOGLE_MAPS_API_KEY=

# Stripe publishable keys — client-safe (only the secret key sk_… must stay
# server-only, as the STRIPE_SECRET_KEY_TEST / STRIPE_SECRET_KEY_LIVE Supabase
# function secrets). Both are shipped so the admin panel Settings tab can flip
# between test and live at runtime (app_settings.stripe_mode) with no rebuild.
# Get them from Stripe Dashboard > Developers > API keys (test and live mode).
VITE_STRIPE_PUBLISHABLE_KEY_TEST=
VITE_STRIPE_PUBLISHABLE_KEY_LIVE=
